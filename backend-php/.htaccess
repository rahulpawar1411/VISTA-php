# If this folder is accidentally used as document root, send traffic into public/
# and block secrets. Preferred setup: point the subdomain document root at public/.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block sensitive paths
  RewriteRule ^(src|uploads|scripts|docs|logs)(/|$) - [F,L]
  RewriteRule ^(\.env|\.gitignore|start\.ps1) - [F,L]

  # Already inside public/ — do nothing
  RewriteRule ^public/ - [L]

  # Route everything else through public/
  RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<Files ".env">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</Files>
