# Same contract as local — fill with shared-hosting MySQL + secrets

DB_HOST=localhost
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_cpanel_db_name
DB_PORT=3306

# Optional single URL (overrides DB_* if set)
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/your_db

PORT=5080
JWT_SECRET=change_me_to_a_long_random_secret
APP_ENV=production

# Only if API is NOT at domain root of the subdomain (rare).
# Example: https://yourdomain.com/crm/public  →  APP_BASE_PATH=crm/public
# APP_BASE_PATH=

# Login lockout (5 fails / 1h → 30 min lock). Recommended on for production.
LOGIN_LOCKOUT=true

# Comma-separated allowed browser origins (your Hostinger web URL and/or Vercel)
FRONTEND_URL=https://yourdomain.com
APP_LOGIN_URL=https://yourdomain.com

# Credentials email (operator/customer create)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Absolute path on shared host if uploads are outside the app folder.
# Leave empty to use ../uploads next to this .env (recommended).
UPLOADS_DIR=
